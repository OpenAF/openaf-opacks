<!DOCTYPE html>
<html>
<head>
  <title>{{title}}</title>
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
  <meta name="viewport" content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
  <meta charset="UTF-8">
  <link rel="stylesheet" href="{{uri}}_d/themes/{{theme}}.css">
</head>
<body>
  <div id="app"></div>
  <script src="{{uri}}_d/docsify.min.js"></script>
  {{#each plugins}}
  <script src="{{../uri}}_d/plugins/{{this}}.min.js"></script>
  {{/each}}
  {{#each langs}}
  <script src="{{../uri}}_p/prism-{{this}}.min.js"></script>
  {{/each}}
  {{#if mermaid}}
  <script src="{{uri}}_m/mermaid.min.js"></script>
  <script>
    var mermaidConfig = {{{mermaidOptions}}};
    mermaidConfig.startOnLoad = false;
    mermaid.initialize(mermaidConfig);
    var _m = {{{options}}}
    function escapeMermaid(value) {
      return value.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    }
    _m.plugins = (_m.plugins || []).concat(function(hook) {
      hook.doneEach(function() {
        mermaid.run({ querySelector: "div.mermaid" }).catch(function(error) { console.error(error); });
      });
    });
    _m.markdown = { 
      renderer: { 
        code: function(code1, lang) { 
          if (lang==="mermaid") {
            var style = "";
            if (code1.startsWith("style=")) {
              var end = code1.indexOf("\n");
              if (end >= 0) {
                style = ' style="' + escapeMermaid(code1.substring(6, end).replace(/^['"]|['"]$/g, "")) + '"';
                code1 = code1.substring(end + 1);
              }
            }
            return '<div class="mermaid"' + style + '>' + escapeMermaid(code1) + '</div>';
          } 
          return this.origin.code.apply(this, arguments); 
        } 
      } 
    }
    window.$docsify = _m; 
  </script>
  <style>
    div.mermaid {
        font-family: 'trebuchet ms', verdana, arial;
    }
  </style>
  {{else}}
  <script>
    window.$docsify = {{{options}}}
  </script> 
  {{/if}}
  {{#if liveupdate}}
  <script>
    var ws;
    function fnConnect() {
      ws = new WebSocket("ws://" + location.host + "/ws");
      ws.onopen = function(e) { };

      ws.onmessage = function(event) {
        console.log("[message websockets] data=" + event.data);
        if (event.data == "reload") location.reload();
      };

      ws.onclose = function(event) {
        fnConnect();
      };

      ws.onerror = function(error) {
        console.log("[error websockets] " + error.message);
      };
    }

    fnConnect();
  </script>
  {{/if}}
</body>
</html>
